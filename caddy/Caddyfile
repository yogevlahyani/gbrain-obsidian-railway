{
	admin off
	auto_https off
}

:{$PORT} {
	route {
		# Optional Cloudflare/origin gate. Only enforced when ORIGIN_SECRET is non-empty.
		# Railway *.up.railway.app browsers cannot set X-Origin-Secret — leave ORIGIN_SECRET
		# unset until you put Cloudflare (or similar) in front and inject the header.
		@blocked expression `{env.ORIGIN_SECRET} != "" && {http.request.header.X-Origin-Secret} != {env.ORIGIN_SECRET}`
		respond @blocked 403

		# Edge health for Railway / probes (not the GBrain /health JSON).
		respond /healthz 200

		# Published vault (Quartz). Exact `/` goes to the site; GBrain keeps /admin, /mcp, …
		redir / /notes/ 302
		redir /notes /notes/ 308

		# Strip /notes so Quartz (served at its own /) sees normal paths.
		# dial_timeout: quartz may restart during rebuilds; avoid instant 502 storms.
		handle_path /notes* {
			reverse_proxy {$QUARTZ_UPSTREAM} {
				transport http {
					dial_timeout 5s
					response_header_timeout 60s
				}
			}
		}

		# GBrain: /admin, /mcp, /authorize, /token, /register, /revoke, /.well-known/*, /health.
		reverse_proxy {$GBRAIN_UPSTREAM}
	}
}
